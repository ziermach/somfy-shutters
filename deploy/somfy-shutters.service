# Install: sudo cp deploy/somfy-shutters.service /etc/systemd/system/
#          sudo systemctl enable --now somfy-shutters
[Unit]
Description=somfy-shutters — roller shutter control
Documentation=https://github.com/ziermach/somfy-shutters
# Pi-Somfy and the broker have to be up first; the app survives them being down,
# but starting after them avoids a pointless first reconnect cycle.
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/somfy-shutters
Environment=SHUTTERS_CONFIG=/home/pi/somfy-shutters/config/shutters.toml
Environment=SHUTTERS_DB=/home/pi/somfy-shutters/config/state.db
ExecStart=/home/pi/somfy-shutters/backend/.venv/bin/uvicorn somfy_shutters.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
# The config holds RTS addresses; keep the unit from writing anywhere else.
ProtectSystem=strict
ReadWritePaths=/home/pi/somfy-shutters/config
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
